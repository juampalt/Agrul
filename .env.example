# ==============================================
# Agrul — Configuración de Entorno Local
# Copiá este archivo a .env:
#   cp .env.example .env
# ==============================================

# Entorno de ejecución
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT: en producción definir JWT_SECRET mediante el gestor de secretos (mínimo 32 bytes).
# En desarrollo, si se omite, se genera una clave aleatoria por proceso;
# reiniciar el servidor invalida las sesiones de desarrollo.
# No usar una clave de ejemplo ni commitear secretos reales.

# Base de Datos PostgreSQL (Local Docker Compose)
DATABASE_URL=postgresql://agrul_user:agrul_pass@localhost:5432/agrul_db

# Parámetros del Contenedor Docker Compose (Opcional)
POSTGRES_DB=agrul_db
POSTGRES_USER=agrul_user
POSTGRES_PASSWORD=agrul_pass
POSTGRES_PORT=5432
